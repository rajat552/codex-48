{
  "name": "cohesora-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cohesora — Evidence-Led Brand Governance Platform",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "start": "npm run start --workspace=apps/api",
