NODE_ENV=development
PORT=4000
API_BASE_PATH=/api/v1

# MongoDB Connection String (leave empty or use mongodb://127.0.0.1:27017/cohesora; if local mongod is unavailable, development mode launches an automated in-memory MongoDB instance)
MONGODB_URI=mongodb://127.0.0.1:27017/cohesora

# Authentication JWT Secrets
JWT_ACCESS_SECRET=replace-with-long-random-access-secret-32-chars-min
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret-32-chars-min
JWT_ISSUER=cohesora-api
JWT_AUDIENCE=cohesora-web
ACCESS_TOKEN_TTL_MINUTES=1440
REFRESH_TOKEN_TTL_DAYS=7

# Gemini Flash AI Provider Settings
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=20000
GEMINI_MAX_RETRIES=1

# Storage and Upload Guard Limits
UPLOAD_DIR=./private-uploads
MAX_UPLOAD_BYTES=10485760
MAX_EXTRACTED_TEXT_CHARS=200000

# CORS and Logging
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=info
DEFAULT_TIMEZONE=UTC
